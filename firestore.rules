rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    // Emails are compared lowercased so a capitalized Google address can never
    // silently fail to match the stored member list.
    function email() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : "";
    }

    // Keep in sync with APP_ADMINS in src/firebase-config.ts.
    function isAdmin() {
      return email() in ["dkforbord@gmail.com"];
    }

    // exists() first: without it, get() on a missing household throws and the
    // whole rule evaluation errors out instead of simply denying.
    function isMember(hid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/households/$(hid))
        && email() in get(/databases/$(database)/documents/households/$(hid)).data.memberEmails;
    }

    // ── Households (metadata only — never the budget blob) ────────────────
    match /households/{hid} {
      // Admins may read households to administer membership.
      allow read: if isMember(hid) || isAdmin();

      // Invite-only: only an admin spins up a new tenant. The owner must be
      // seeded as a member, so a household is never created unreachable.
      allow create: if isAdmin()
        && request.resource.data.ownerEmail is string
        && request.resource.data.memberEmails is list
        && request.resource.data.ownerEmail in request.resource.data.memberEmails;

      // Members invite by adding an email (Household tab → Add member).
      allow update: if isMember(hid) || isAdmin();
      allow delete: if false;
    }

    // ── Budgets (the money) ───────────────────────────────────────────────
    // Members only. Admins deliberately do NOT get a backdoor here: being able
    // to administer who belongs to a household is not a reason to read every
    // household's finances.
    match /budgets/{hid} {
      allow read, write: if isMember(hid);
    }

    // TEMPORARY — the pre-multi-tenant single budget doc. Readable by its two
    // original members so the app can copy it into their new household on
    // first create. DELETE THIS BLOCK once that migration has happened.
    // (A doc matched by several blocks is allowed if any one of them allows it.)
    match /budgets/household {
      allow read: if email() in ["dkforbord@gmail.com", "isabellasmith011@gmail.com"];
    }

    // ── Bank sync (Phase 2) ───────────────────────────────────────────────
    // The SimpleFIN access URL is a bearer credential for reading someone's
    // bank data. No client may ever touch it: only Cloud Functions, whose
    // Admin SDK bypasses these rules entirely.
    match /connections/{uid} {
      allow read, write: if false;
    }

    // Safe, non-secret mirror of the connection's state, so the UI can show
    // "last synced" / "needs reconnect" without exposing the credential.
    match /connectionStatus/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
